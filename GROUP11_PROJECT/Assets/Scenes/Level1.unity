--- !u!114 &628511263
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 628511256}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1a54a76de1901794a91ad4d76b21afc0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  letterText:
    name: XOXO
    pages:
    - "Em,\r\nHey long time\r\nMust be annoying since your new boarding school took
      your phone\r\nNever really sent through post before so there\u2019s something\r\nBut
      more on that later, I\u2019ve been meaning to ask since your back in town this\r\nweekend\r\nmaybe
      if we could go out sometime\r\nJust the 2 of us\r\nTheres this new spot down
      the street from Henfield park\r\nShocker that place is still open after all
      the weird crap that happened there\r\nAnyways, write back when you get a sec\r\nCan\u2019t
      wait to see you\n\r\n~Sam"
    - "Sam,\r\nHey good to hear from you too\r\nYeah having my phone taken does blow
      but You tend to forget with all the stuff you\r\ncan do on campus so meh\r\nI
      would love to but I\u2019m only leaving Saturday because my boyfriend has to
      take his\r\ncar to the shop\r\nIf I get an opening I would love to, maybe even
      introduce you to him\r\nWell see you then\n\r\n~Em"
  manager: {fileID: 330311626}
